---
import { getCollection } from "astro:content";
import Container from "./Container.astro";
import Title from "./Title.astro";
import NorwegianDate from "./NorwegianDate.astro";

const posts = await getCollection("blog");
const latestPosts = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);
---

<section id="blog">
  <Container class="blur-in">
    <div class="container grid grid-cols-3 mx-auto py-16 gap-3 add-perspective">
      <div>
        <Title backHref="/" class="sticky top-16"> Blog. </Title>
        <p class="uppercase text-sm text-neutral-600 text-balance">
          Thoughts, tutorials, and insights.
        </p>
      </div>
      <div></div>
      <div></div>
      
      {latestPosts.length === 0 ? (
        <p class="col-span-3 text-neutral-600 text-sm uppercase font-doto scale-in" style="animation-delay: 150ms">
          My thoughts will be uploaded here when I have them.
        </p>
      ) : latestPosts.map((post, index) => (
        <a 
          href={`/blog/${post.id}/`}
          class="border-dotted border-neutral-800 p-3 w-full flex flex-col justify-end relative card group scale-in"
          style={`grid-column: ${(index % 3) + 1}; animation-delay: ${index * 50 + 150}ms`}
        >
          <h3 class="font-doto uppercase font-medium text-sm mb-2">
            {post.data.title}
          </h3>
          <p class="text-neutral-400 text-xs mb-2 line-clamp-2">
            {post.data.description}
          </p>
          <time class="text-neutral-600 text-xs">
            <NorwegianDate date={post.data.pubDate} />
          </time>
        </a>
      ))}
    </div>
  </Container>
</section>
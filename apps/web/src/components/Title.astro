---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h1"> & {
  backHref?: string;
};

const { class: className, backHref, ...props } = Astro.props;

const Tag = backHref ? "a" : "span";
---

<h1
  {...props}
  class:list={[
    "pb-4 text-2xl font-medium uppercase  group ",
    backHref && "cursor-pointer -ml-[28px]",
    className,
  ]}
>
  <Tag href={backHref} class="flex items-center gap-[4px]">
    {
      backHref && (
        <span class="block w-[24px] overflow-hidden">
          <Icon
            size="24px"
            class="translate-x-1/2 group-hover:translate-x-0 transition-transform duration-300 group-hover:text-rose-500 -mt-[2px]"
            name="arrow-left"
          />
        </span>
      )
    }

    <slot />
  </Tag>
</h1>

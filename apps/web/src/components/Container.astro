---
import { Icon } from "astro-icon/components";
type Props = {
  large?: boolean;
  class?: string;
  style?: string;
  max?: boolean;
};

const { large, class: className, max, ...props } = Astro.props;
---

<div
  data-container
  {...props}
  class:list={["container", className, large && "large", max && "max"]}
>
  <slot />
  <Icon
    data-target
    name="carbon:add"
    class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 text-rose-500"
  />
  <Icon
    data-target
    name="carbon:add"
    class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 text-rose-500"
  />
  <Icon
    data-target
    name="carbon:add"
    class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 text-rose-500"
  />
  <Icon
    data-target
    name="carbon:add"
    class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 text-rose-500"
  />
  <!-- <span class="plus tl"></span>
  <span class="plus tr"></span>
  <span class="plus bl"></span>
  <span class="plus br"></span> -->
</div>

<style>
  .container {
    max-width: min(calc(100vw - 1rem), 700px);
    margin: 0 auto;
    border-left: 1px dotted light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.1));
    border-right: 1px dotted
      light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.1));
    padding-inline: 1rem;
    position: relative;

    &.large {
      max-width: min(calc(100vw - 1rem), 900px);
    }
    &.max {
      max-width: 100%;
    }
  }

  .plus {
    --size: 8px;
    width: var(--size);
    height: var(--size);
    position: absolute;
    color: crimson;
    &.tl {
      top: calc(var(--size) * -1);
      left: calc(var(--size) * -1);
    }
    &.tr {
      top: calc(var(--size) * -1);
      right: calc(var(--size) * -1);
    }
    &.bl {
      bottom: calc(var(--size) * -1);
      left: calc(var(--size) * -1);
    }
    &.br {
      bottom: calc(var(--size) * -1);
      right: calc(var(--size) * -1);
    }
    &::before {
      content: "";
      height: 1px;
      width: 100%;
      background: currentColor;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(90deg);
    }

    &::after {
      content: "";
      height: 1px;
      width: 100%;
      background: currentColor;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }
</style>

<script>
  const element = document.querySelector<HTMLElement>("[data-container]");

  if (element?.dataset.minigame) {
    // Minigame: Each icon must be clickable.
    function check() {
      const icons = element!.querySelectorAll<HTMLElement>("svg[data-target]");

      return Array.from(icons).every((icon) => {
        return icon.dataset.clicked === "true";
      });
    }

    const icons = element.querySelectorAll<HTMLElement>("svg[data-target]");
    icons.forEach((icon) => {
      icon.style.cursor = "pointer";
      icon.addEventListener("click", () => {
        icon.dataset.clicked = "true";
        icon.style.opacity = "0.5";
        if (check()) {
          element.dataset.minigameComplete = "true";
        }
      });
    });
  }
</script>

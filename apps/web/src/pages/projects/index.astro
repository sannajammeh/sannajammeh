---
import { getCollection } from "astro:content";
import Container from "../../components/Container.astro";
import Layout from "../../layouts/Layout.astro";
import { staircase } from "../../util/staircase";
import { Image } from "astro:assets";
import Plus from "../../components/Plus.astro";
import { createGetColor } from "../../util/staircase";
import { Icon } from "astro-icon/components";
import Title from "../../components/Title.astro";

const projects = await getCollection("projects");

const getColor = createGetColor();

const getImagePos = (pos: string) => {
  switch (pos) {
    case "center":
      return "object-center";
    default:
      return "object-top";
  }
};

const sortedProjects = projects
  .toSorted((a, b) => {
    // compare by project.data.keywords - sort similar locale comparison

    const aKeywords = a.data.keywords?.toSorted();
    const bKeywords = b.data.keywords?.toSorted();
    if (!aKeywords || !bKeywords) return 0;

    const aKeywordsString = aKeywords.join(" ");

    const bKeywordsString = bKeywords.join(" ");

    // also compare by length

    if (aKeywordsString.length !== bKeywordsString.length) {
      return bKeywordsString.length - aKeywordsString.length;
    }

    return aKeywordsString.localeCompare(bKeywordsString);
  })
  .filter((val) => !val.data.bury)
  .concat(projects.filter((v) => v.data.bury));
---

<Layout>
  <main class="h-screen grid items-center w-full">
    <Container class="blur-in">
      <div
        class="container grid grid-cols-3 mx-auto py-16 gap-3 add-perspective"
      >
        <div>
          <Title backHref="/" class="sticky top-16"> Projects. </Title>
          <p class="uppercase text-sm text-neutral-600 text-balance">
            Customers I've worked with, sites I've made.
          </p>
        </div>
        <div></div>
        <div></div>
        {
          sortedProjects.map((project, index) => {
            const {
              image,
              href,
              keywords,
              dark_on_hover,
              title,
              image_position,
            } = project.data;

            const hasContent = !!project.body;

            const Tag = href || hasContent ? "a" : "article";
            return (
              <Tag
                href={hasContent ? `/projects/${project.id}` : href}
                target={href && !hasContent ? "_blank" : undefined}
                class="border-dotted border-neutral-800 p-3 w-full flex flex-col justify-end relative card group scale-in"
                style={`grid-column: ${(index % 3) + 1}; animation-delay: ${index * 50 + 150}ms`}
              >
                {image ? (
                  <div class="w-full aspect-video relative z-[-1] grayscale sepia opacity-25 group-hover:opacity-100 group-hover:grayscale-[0] group-hover:sepia-[0] transition-[opacity,filter] overflow-hidden">
                    <Image
                      layout="full-width"
                      src={image as any}
                      alt="A bird."
                      inferSize
                      class:list={[
                        "object-cover absolute inset-0 w-full h-full",
                        "mask",
                        getImagePos(image_position),
                      ]}
                    />
                  </div>
                ) : //   <div class="aspect-video w-full grid place-content-center">
                //     <Icon size="5rem" name="rocket" />
                //   </div>
                null}

                <h3
                  class:list={[
                    "font-doto uppercase font-medium text-sm",
                    // "group-hover:-translate-y-[calc(100%_+_1rem)] group-hover:scale-[1.1] transition-transform",
                    // dark_on_hover && "group-hover:text-black",
                  ]}
                >
                  {title}
                </h3>

                {keywords && (
                  <dl class="flex gap-3">
                    <dt class="sr-only">Keywords</dt>
                    {keywords.toSorted().map((keyword) => (
                      <Plus
                        as="dd"
                        class:list={[
                          "text-[9px] uppercase py-0.5 px-1 border border-dotted relative",
                          getColor(keyword.toLowerCase()),
                        ]}
                      >
                        {keyword}
                      </Plus>
                    ))}
                  </dl>
                )}
              </Tag>
            );
          })
        }
      </div>
    </Container>
  </main>
</Layout>

<style>
  /* .vintage {
    &::after {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0.6;
      background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><filter id='noise' x='0%' y='0%' width='100%' height='100%'><feTurbulence baseFrequency='0.5' /></filter><rect x='0' y='0' width='100%' height='100%' filter='url(%23noise)' /></svg>"),
        #f003;
      backdrop-filter: grayscale(100%) contrast(150%);
      mix-blend-mode: darken;
      transition: opacity 0.3s ease-in-out;
    }
  } */

  .card {
    &:hover {
      & .vintage {
        &::after {
          opacity: 0;
        }
      }
    }
  }

  .mask {
    mask-image:
      radial-gradient(circle at center, black 1px, transparent 0),
      radial-gradient(circle at center, black 1px, transparent 0);
    mask-size: 4px 4px;
    transition: mask-size 0.3s ease-in-out;
    transition-property: brightness, mask-size;
    filter: brightness(2);
  }

  .group:hover {
    & .mask {
      mask-size: 0.1px 0.1px;
      filter: brightness(1);
    }
  }
</style>

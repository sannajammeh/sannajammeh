      </hgroup>
      <p class="mt-4">
        Building everything from large <span class="text-rose-500"
          >eCommerce</span
        > stores to distributed systems.
      </p>
      <Nav />

      <!-- <Wolf />
      <Projects /> -->
    </Container>
  </Main>
